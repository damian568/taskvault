# .env.example - TEMPLATE of the settings TaskVault needs (dummy values only).
# Usage:  copy .env.example .env   ->  then change the passwords in .env
# .env is in .gitignore and must NEVER be committed.
# Docker Compose reads .env automatically and fills in ${VARIABLES} in docker-compose.yml.

# Name of the PostgreSQL database
POSTGRES_DB=taskvault

# PostgreSQL SUPERUSER - can do anything. Used ONLY by the db container
# to initialise the database. The app never receives these credentials.
POSTGRES_USER=taskvault_admin
POSTGRES_PASSWORD=change_me_admin_password

# LIMITED application user - may only read/write rows in the "tasks" table.
# These are the ONLY database credentials the app container gets (least privilege).
APP_DB_USER=taskvault_app
APP_DB_PASSWORD=change_me_app_password
